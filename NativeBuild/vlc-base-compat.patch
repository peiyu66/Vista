--- /dev/null
+++ b/modules/video_output/apple/vista_cvpx_vout.c
@@ -0,0 +1,136 @@
+/* Candidate internal VLC module. Needs integration into the pinned source build.
+ * Neither compiled-in registration nor a LibVLC public setter is provided by SDK.
+ * No UIView, drawable, software converter, pixel lock/readback or display layer. */
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_codec.h>
+#include <vlc_vout_display.h>
+#include "../../codec/vt_utils.h"
+#include <vlc_vista_cvpx.h>
+
+typedef struct {
+    vista_cvpx_bridge *bridge; /* app owns until player stop + this Close complete */
+    uint64_t generation;      /* immutable for this producer lifetime */
+} vista_vout;
+
+static bool cvpx_chroma(vlc_fourcc_t chroma)
+{
+    switch (chroma) {
+    case VLC_CODEC_CVPX_NV12: case VLC_CODEC_CVPX_P010:
+    case VLC_CODEC_CVPX_I420: case VLC_CODEC_CVPX_UYVY:
+    case VLC_CODEC_CVPX_BGRA: return true;
+    default: return false;
+    }
+}
+
+static bool vt_context(vlc_video_context *ctx)
+{
+    if (!ctx || !vlc_video_context_GetCVPXPrivate(ctx, CVPX_VIDEO_CONTEXT_VIDEOTOOLBOX))
+        return false;
+    vlc_decoder_device *device = vlc_video_context_HoldDevice(ctx);
+    if (!device) return false;
+    bool valid = device->type == VLC_DECODER_DEVICE_VIDEOTOOLBOX;
+    vlc_decoder_device_Release(device);
+    /* Context subtype/device identify VT path, NOT the session's hardware flag. */
+    return valid;
+}
+
+static void Close(vout_display_t *vd)
+{
+    vista_vout *s = vd->sys;
+    vista_cvpx_detach(s->bridge, s->generation);
+    free(s); vd->sys = NULL;
+}
+
+static void Prepare(vout_display_t *vd, picture_t *pic,
+                    const struct vlc_render_subpicture *subpic, vlc_tick_t deadline)
+{
+    vista_vout *s = vd->sys;
+    CVPixelBufferRef pixel = NULL;
+    /* Strictly refuse unexpected software pictures; never ask VLC to convert. */
+    if (!subpic && cvpx_chroma(pic->format.i_chroma) && pic->context
+        && vt_context(pic->context->vctx))
+        pixel = cvpxpic_get_ref(pic);
+    uint32_t reasons = (subpic ? 1 : 0) | (!cvpx_chroma(pic->format.i_chroma) ? 2 : 0)
+        | (!pic->context ? 4 : 0) | (pic->context && !vt_context(pic->context->vctx) ? 8 : 0)
+        | (!pixel ? 16 : 0);
+    vista_cvpx_note_pipeline(s->bridge, VISTA_PIPE_VOUT_PREPARE, pixel == NULL, 0,
+                             reasons, pic->format.i_chroma);
+    vista_cvpx_prepare(s->bridge, s->generation, (uintptr_t)pic, pixel,
+                       &pic->format, vd->source, pic->date, deadline,
+                       vd->cfg->projection, vd->cfg->stereo_mode,
+                       pic->b_progressive, pic->b_multiview_left_eye, pic->i_nb_fields);
+    /* No notification/delivery here; VLC still waits on its clock after Prepare. */
+}
+
+static void Display(vout_display_t *vd, picture_t *pic)
+{
+    vista_vout *s = vd->sys;
+    bool published = vista_cvpx_display(s->bridge, s->generation, (uintptr_t)pic, vlc_tick_now());
+    vista_cvpx_note_pipeline(s->bridge, VISTA_PIPE_VOUT_DISPLAY, !published, 0, 0, 0);
+}
+
+static int UpdateFormat(vout_display_t *vd, const video_format_t *fmt,
+                        vlc_video_context *ctx)
+{
+    vista_vout *s = vd->sys;
+    uint32_t reasons = (fmt->p_palette ? 1 : 0) | (!cvpx_chroma(fmt->i_chroma) ? 2 : 0)
+        | (!vt_context(ctx) ? 4 : 0);
+    int status = reasons ? VLC_EGENERIC : VLC_SUCCESS;
+    vista_cvpx_note_pipeline(s->bridge, VISTA_PIPE_VOUT_UPDATE, reasons != 0, status, reasons, fmt->i_chroma);
+    return status;
+}
+
+static int Projection(vout_display_t *vd, video_projection_mode_t projection)
+{
+    (void)vd; (void)projection;
+    /* Preserve packed source. Vista owns projection; this module never projects. */
+    return VLC_SUCCESS;
+}
+
+static int Stereo(vout_display_t *vd, vlc_stereoscopic_mode_t stereo)
+{
+    (void)vd; (void)stereo;
+    return VLC_SUCCESS;
+}
+
+static int Open(vout_display_t *vd, video_format_t *fmt, vlc_video_context *ctx)
+{
+    vista_cvpx_bridge *bridge = var_InheritAddress(vd, "vista-cvpx-bridge");
+    uint32_t reasons = (fmt->p_palette ? 1 : 0) | (!cvpx_chroma(fmt->i_chroma) ? 2 : 0)
+        | (!vt_context(ctx) ? 4 : 0);
+    if (reasons) {
+        vista_cvpx_note_pipeline(bridge, VISTA_PIPE_VOUT_OPEN, true, VLC_EGENERIC, reasons, fmt->i_chroma);
+        return VLC_EGENERIC;
+    }
+    if (!bridge) return VLC_EGENERIC;
+    vista_vout *s = calloc(1, sizeof(*s));
+    if (!s) {
+        vista_cvpx_note_pipeline(bridge, VISTA_PIPE_VOUT_OPEN, true, VLC_ENOMEM, 8, fmt->i_chroma);
+        return VLC_ENOMEM;
+    }
+    s->bridge = bridge;
+    if (!vista_cvpx_attach(bridge, &s->generation)) {
+        vista_cvpx_note_pipeline(bridge, VISTA_PIPE_VOUT_OPEN, true, VLC_EGENERIC, 16, fmt->i_chroma);
+        free(s); return VLC_EGENERIC;
+    }
+    static const struct vlc_display_operations ops = {
+        .close = Close, .prepare = Prepare, .display = Display,
+        .update_format = UpdateFormat, .change_source_projection = Projection,
+        .set_stereo = Stereo,
+    };
+    vd->sys = s; vd->ops = &ops;
+    vista_cvpx_note_pipeline(bridge, VISTA_PIPE_VOUT_OPEN, false, VLC_SUCCESS, 0, fmt->i_chroma);
+    return VLC_SUCCESS; /* fmt unchanged: no CPU conversion request */
+}
+
+vlc_module_begin()
+    set_shortname("Vista CVPX research")
+    set_description("Scheduled CVPX leases for an external Vista renderer")
+    set_subcategory(SUBCAT_VIDEO_VOUT)
+    add_shortcut("vista-cvpx")
+    set_callback_display(Open, 0) /* explicit opt-in only */
+vlc_module_end()
