+    /// Async form of the single-attempt, fresh-manager connection.
+    open func connectShareOnce(name: String, encrypted: Bool = false) async throws {
+        try await withCheckedThrowingContinuation { continuation in
+            connectShareOnce(
+                name: name, encrypted: encrypted, completionHandler: asyncHandler(continuation)
+            )
+        }
+    }
