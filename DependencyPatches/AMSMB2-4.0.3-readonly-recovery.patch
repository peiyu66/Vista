+    /// Retires this manager without sending a disconnect or any other network RPC.
+    /// The caller must prevent new work before calling and never reuse this manager.
+    /// Completion follows queue drain, including return from operation callbacks.
+    open func retireLocallyAfterDraining(completionHandler: @Sendable @escaping () -> Void) {
+        q.async {
+            // Do not hold connectLock while waiting: queued connect operations
+            // need it before they can finish and decrement operationCount.
+            self.operationLock.lock()
+            while self.operationCount > 0 {
+                self.operationLock.wait()
+            }
+            self.operationLock.unlock()
+
+            self.connectLock.lock()
+            self.client?.invalidateLocally()
+            self.client = nil
+            self.connectLock.unlock()
+            completionHandler()
+        }
+    }
+
+    /// Async local retirement. Cancellation does not skip the required drain.
+    open func retireLocallyAfterDraining() async {
+        await withCheckedContinuation { continuation in
+            retireLocallyAfterDraining { continuation.resume() }
         }
     }
 
