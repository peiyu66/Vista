+    /// Connects a fresh manager exactly once, with the normal security settings.
+    /// Unlike connectShare, this does not send an echo or retry a failed connect.
+    /// Use a newly initialized manager; a failed attempt must be retired locally.
+    open func connectShareOnce(
+        name: String, encrypted: Bool = false, completionHandler: SimpleCompletionHandler
+    ) {
+        with(completionHandler: completionHandler) {
+            self.connectLock.lock()
+            defer { self.connectLock.unlock() }
+            guard self.client == nil else {
+                throw SMB2OperationFailure(origin: .submission, posixCode: EALREADY)
+            }
+            self.client = try self.connect(shareName: name, encrypted: encrypted)
+        }
+    }
